# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB Atlas ----
# Atlas -> Database -> Connect -> Drivers -> copy string, replace <password>
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/petcare?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- CORS (comma separated) ----
CLIENT_URLS=http://localhost:5173,http://localhost:3000

# ---- AI (Google Gemini) ----
# https://aistudio.google.com/app/apikey  -- free tier available
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- UPI payments ----
# Your own UPI ID. Money from the QR lands here directly.
# Example: 9876543210@ybl  or  yourname@okicici
MERCHANT_VPA=
MERCHANT_NAME=Pet Care Hub
# Catalogue prices are in USD; UPI only moves rupees.
USD_TO_INR=88
